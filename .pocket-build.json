// .site-repo.json
{
  "builds": [
    {
      // List of files and directories to copy into dist-site-repo
      "include": [
        ".gitignore",
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "LICENSE-CONTENT",
        "NOTICE",
        { "src": "README-SITE-REPO.md", "dest": "README.md" }
      ],
      "out": "_dist-site-repo"
    }
  ]
}	
